{
  "name": "@fabiensalles/deck",
  "version": "0.1.1",
  "description": "Astro integration for Reveal.js presentations with exercises, corrections, and PDF export",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/integration/index.js",
      "types": "./dist/integration/index.d.ts"
    },
    "./content": {
      "import": "./dist/content/index.js",
      "types": "./dist/content/index.d.ts"
    },
    "./reveal": {
      "import": "./dist/reveal/index.js",
      "types": "./dist/reveal/index.d.ts"
    },
    "./all": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components/*": "./dist/components/*",
    "./styles/*": "./dist/styles/*",
    "./pages/*": "./dist/pages/*",
    "./virtual": {
      "types": "./dist/virtual.d.ts"
    }
  },
  "bin": {
    "deck-pdf": "dist/pdf-export/index.js"
  },
  "files": [
    "dist/",
    "examples/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.js && node scripts/copy-assets.js",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ scripts/ e2e/scripts/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "mermaid": "^11.0.0",
    "sass": "^1.83.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^17.0.0",
    "puppeteer-core": "^24.0.0",
    "reveal.js": "^5.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "astro": "^5.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "mermaid": "^11.13.0",
    "pngjs": "^7.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "reveal.js",
    "presentations",
    "slides",
    "pdf-export"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabienSalles/deck.git"
  },
  "homepage": "https://github.com/FabienSalles/deck#readme"
}
