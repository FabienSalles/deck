---
import BaseLayout from './BaseLayout.astro';
import 'virtual:deck/styles/document';

interface Props {
  title: string;
  deckTitle: string;
  type: 'exercices' | 'corrections';
}

const { title, deckTitle, type } = Astro.props;
const typeLabel = type === 'exercices' ? 'Exercises' : 'Corrections';
---

<BaseLayout title={`${typeLabel} - ${deckTitle}`}>
  <div class="document-page" data-type={type}>
    <header class="document-header">
      <div class="header-content">
        <a href="/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Menu
        </a>
        <span class="formation-badge">{deckTitle}</span>
        <h1>{title}</h1>
      </div>
      <nav class="document-actions">
        <button type="button" class="print-btn" onclick="window.print()" title="Print">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print
        </button>
      </nav>
    </header>

    <main class="document-content">
      <slot />
    </main>

    <footer class="document-footer">
      <span class="copyright">{deckTitle} - {typeLabel}</span>
    </footer>
  </div>
</BaseLayout>

<script>
  const DOCUMENT_MERMAID_CONFIG = {
    startOnLoad: false,
    theme: 'default',
    securityLevel: 'loose',
    logLevel: 'error',
    flowchart: {
      curve: 'basis',
      padding: 20,
      nodeSpacing: 50,
      rankSpacing: 50,
      htmlLabels: true,
      useMaxWidth: true,
    },
    sequence: {
      diagramMarginX: 50,
      diagramMarginY: 10,
      useMaxWidth: true,
    },
    fontFamily: '"Inter", "Segoe UI", system-ui, -apple-system, sans-serif',
    themeVariables: {
      primaryColor: '#f8fafc',
      primaryTextColor: '#0f172a',
      primaryBorderColor: '#334155',
      secondaryColor: '#f1f5f9',
      secondaryTextColor: '#0f172a',
      secondaryBorderColor: '#475569',
      tertiaryColor: '#e2e8f0',
      tertiaryTextColor: '#0f172a',
      tertiaryBorderColor: '#64748b',
      lineColor: '#334155',
      clusterBkg: '#e2e8f0',
      clusterBorder: '#475569',
      fontSize: '14px',
      background: '#ffffff',
      mainBkg: '#f8fafc',
      nodeBorder: '#334155',
      nodeTextColor: '#0f172a',
      textColor: '#0f172a',
    },
  } as const;

  function toDiagram(svg: string): HTMLElement | null {
    const container = document.createElement('div');
    container.className = 'mermaid-diagram';

    const parsed = new DOMParser().parseFromString(svg, 'image/svg+xml');

    if (parsed.querySelector('parsererror') !== null) {
      return null;
    }

    const svgElement = parsed.documentElement;

    if (svgElement.tagName.toLowerCase() !== 'svg') {
      return null;
    }

    svgElement.removeAttribute('width');
    svgElement.removeAttribute('height');
    svgElement.style.maxWidth = '100%';
    svgElement.style.height = 'auto';
    container.appendChild(document.importNode(svgElement, true));

    return container;
  }

  async function renderMermaidDiagrams(): Promise<void> {
    const blocks = document.querySelectorAll<HTMLElement>(
      'pre code.mermaid-diagram-source, pre code.language-mermaid, pre code.mermaid'
    );

    if (blocks.length === 0) {
      return;
    }

    const mermaid = (await import('mermaid')).default;
    mermaid.initialize(DOCUMENT_MERMAID_CONFIG);

    for (const [index, block] of [...blocks].entries()) {
      const pre = block.parentElement;

      if (pre === null || block.hasAttribute('data-mermaid-rendered')) {
        continue;
      }

      const definition = block.textContent?.trim() || '';

      if (definition === '') {
        continue;
      }

      block.setAttribute('data-mermaid-rendered', 'true');

      try {
        const { svg } = await mermaid.render(`mermaid-doc-${index}`, definition);
        const diagram = toDiagram(svg);

        if (diagram !== null) {
          pre.replaceWith(diagram);
        }
      } catch {
        // Leave the code block as-is if rendering fails
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderMermaidDiagrams();
    });
  } else {
    renderMermaidDiagrams();
  }
</script>
