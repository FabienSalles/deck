---
import BaseLayout from './BaseLayout.astro';
import 'virtual:deck/styles/document';

interface Props {
  title: string;
  deckTitle: string;
  type: 'exercices' | 'corrections';
}

const { title, deckTitle, type } = Astro.props;
const typeLabel = type === 'exercices' ? 'Exercises' : 'Corrections';
---

<BaseLayout title={`${typeLabel} - ${deckTitle}`}>
  <div class="document-page" data-type={type}>
    <header class="document-header">
      <div class="header-content">
        <a href="/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Menu
        </a>
        <span class="formation-badge">{deckTitle}</span>
        <h1>{title}</h1>
      </div>
      <nav class="document-actions">
        <button type="button" class="print-btn" onclick="window.print()" title="Print">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print
        </button>
      </nav>
    </header>

    <main class="document-content">
      <slot />
    </main>

    <footer class="document-footer">
      <span class="copyright">{deckTitle} - {typeLabel}</span>
    </footer>
  </div>
</BaseLayout>

<script>
  // Mermaid diagram rendering for documents.
  // The SVG output from mermaid.render() is safe — it is generated by the
  // mermaid library from a controlled DSL (not arbitrary user HTML), so
  // injecting it into the DOM via innerHTML is the standard and recommended
  // approach (see mermaid official docs).
  async function renderMermaidDiagrams(): Promise<void> {
    const blocks = document.querySelectorAll<HTMLElement>('pre code.language-mermaid');

    if (blocks.length === 0) {
      return;
    }

    const mermaid = (await import('mermaid')).default;
    mermaid.initialize({ startOnLoad: false, theme: 'default' });

    for (const block of blocks) {
      const pre = block.parentElement;

      if (pre === null) {
        continue;
      }

      const definition = block.textContent || '';
      const container = document.createElement('div');
      container.classList.add('mermaid');

      try {
        const { svg } = await mermaid.render(`mermaid-${Math.random().toString(36).slice(2)}`, definition);
        // Safe: SVG is generated by the mermaid library from its own DSL, not from untrusted user input
        container.innerHTML = svg; // eslint-disable-line no-unsanitized/property
        pre.replaceWith(container);
      } catch {
        // Leave the code block as-is if rendering fails
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderMermaidDiagrams();
    });
  } else {
    renderMermaidDiagrams();
  }
</script>
